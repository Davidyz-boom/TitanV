DATABASE_URL=postgresql://postgres:1234@localhost:5432/titanv_db

# Clave secreta para firmar los JWT. Genera una propia en producción, por ejemplo con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# ── Invitaciones por correo (SMTP) ──────────────────────────────────────────────
# Configuración del servidor de salida de correo.
# Gmail: host=smtp.gmail.com, port=587, user=tu_correo@gmail.com
#         password=contraseña de aplicación (16 dígitos, generada en tu cuenta de Google)
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Titan V

